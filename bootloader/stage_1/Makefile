all: $(BOOTLOADER_BIN)

ASFLAGS=-DLOADER_NUM_SECTORS=$(LOADER_NUM_SECTORS) -DDISK_HEADS=$(DISK_HEADS) -DDISK_SECTORS_PER_TRACK=$(DISK_SECTORS_PER_TRACK) -DDISK_SECTOR_SIZE_BYTES=$(DISK_SECTOR_SIZE_BYTES)

$(BOOTLOADER_BIN): $(BOOTLOADER_DIR)/stage_1/mbr.asm
	$(ASM) -I$(BOOTLOADER_DIR) $(ASFLAGS) $< -f bin -o $(BUILD_DIR)/$@