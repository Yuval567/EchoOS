all: $(LOADER_BIN)

ASFLAGS=-DKERNEL_LOAD_ADDRESS=$(KERNEL_LOAD_ADDRESS) -DKERNEL_STACK_TOP_ADDRESS=$(KERNEL_STACK_TOP_ADDRESS) -DLOADER_NUM_SECTORS=$(LOADER_NUM_SECTORS) -DKERNEL_NUM_SECTORS=$(KERNEL_NUM_SECTORS) -DDISK_HEADS=$(DISK_HEADS) -DDISK_SECTORS_PER_TRACK=$(DISK_SECTORS_PER_TRACK) -DDISK_SECTOR_SIZE_BYTES=$(DISK_SECTOR_SIZE_BYTES)  

# Calculate size of loader in bytes
LOADER_SIZE_BYTES = $$(( $(LOADER_NUM_SECTORS) * $(DISK_SECTOR_SIZE_BYTES) ))

$(LOADER_BIN): $(BOOTLOADER_DIR)/stage_2/loader.asm
	$(ASM) -I$(BOOTLOADER_DIR) $(ASFLAGS) $< -f bin -o $(BUILD_DIR)/$@
	truncate -s $(LOADER_SIZE_BYTES) $(BUILD_DIR)/$@ 